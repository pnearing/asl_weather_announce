#!/bin/sh
set -e

# Create log directory if it doesn't exist
if [ ! -d /var/log ]; then
    mkdir -p /var/log
fi

# Create cache directory
cache_dir="/var/cache/asl_weather_announce"
if [ ! -d "$cache_dir" ]; then
    mkdir -p "$cache_dir"
    chmod 755 "$cache_dir"
fi

# Create symlink for backwards compatibility if needed
if [ ! -f /etc/asl_weather.conf ] && [ -f /etc/asl_weather.conf.example ]; then
    # Don't auto-install config, let user do it manually
    :
fi

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
